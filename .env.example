# Polyticks Environment Configuration
# ===================================
# UNIFIED env vars used by: ETL scripts, Edge Functions (server-side)
# Copy this file to `.env` and fill in your Supabase project values.
# NEVER commit the .env file.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Client-Side (Next.js Web) ─────────────────────────────────────────────
# These are bundled into the web client — safe because they're the
# Cloudflare Workers reverse proxy URL, NOT raw Supabase credentials.
NEXT_PUBLIC_SUPABASE_URL=https://polyticks-api.rex6rocks.workers.dev
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Optional: Third-party APIs ────────────────────────────────────────────
# GROQ_API_KEY=
# HF_API_TOKEN=
# DIGITAL_SANSAD_API_BASE=
